# Allowlist: only configs are tracked. Add a "!path" line to track a new file.
*
!*/
!.gitignore
!README.md
!*/docker-compose.yml
!*/.env.example
!*/*.env.example
!proxy/Caddyfile
!proxy/Dockerfile
!dashboard/config/*.yaml
!dashboard/config/custom.css
!dashboard/config/custom.js
!diun/images.yml
!gitea/runner/config.yaml
!immich/hwaccel.transcoding.yml
!auth/configuration.yml
!auth/users_database.example.yml
!admin/scrutiny/collector.yaml
!apps/vikunja-config.yml
!scripts/*.sh
!scripts/restic-excludes.txt
!docs/index.html
!docs/.nojekyll

# media/ is a separate private repo
media/

