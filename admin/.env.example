# Template: same keys as .env, values removed. Real values are in the offsite backup.
# Scrutiny alerts to ntfy topic "disks":
#   ntfy://:<publisher token>@ntfy.<domain>/disks?priority=urgent&tags=rotating_light
SCRUTINY_NOTIFY_URL=

# Pool drives for Scrutiny, by id: ls /dev/disk/by-id/ | grep -v part
DISK_SDA=
DISK_SDB=
DISK_SDC=
DISK_SDD=
