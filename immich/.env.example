# Template: same keys as .env, values removed. Real values are in the offsite backup.
# Docs for all variables: https://docs.immich.app/install/environment-variables

# Photos/videos, on the pool
UPLOAD_LOCATION=

# Postgres, on the NVMe (relative to this folder). Not on mergerfs.
DB_DATA_LOCATION=

TZ=

# Major version
IMMICH_VERSION=

# A-Za-z0-9 only
DB_PASSWORD=

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=
DB_DATABASE_NAME=
