# Template: same keys as .env, values removed. Real values are in the offsite backup.
# Wildcard certificate domain (*.BASE_DOMAIN)
BASE_DOMAIN=

# Jellyfin, Immich, oCIS and Homepage hostnames
DOMAIN=
IMMICH_DOMAIN=
OCIS_DOMAIN=
HOMEPAGE_DOMAIN=

# Cloudflare API token for the DNS-01 challenge: "Edit zone DNS" template, scoped to the one
# zone (Zone/DNS/Edit and Zone/Zone/Read).
CF_API_TOKEN=
