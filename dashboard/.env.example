# Template: same keys as .env, values removed. Real values are in the offsite backup.
# Used in config/services.yaml as {{HOMEPAGE_VAR_*}}
# Jellyfin: Dashboard > API Keys

HOMEPAGE_VAR_JELLYFIN_KEY=
# Gitea token, read-only (notifications, repos, issues)
HOMEPAGE_VAR_GITEA_KEY=

# Immich Account Settings > API Keys; then uncomment the widget in config/services.yaml
HOMEPAGE_VAR_IMMICH_KEY=

# GID of the host's "docker" group, for container status
DOCKER_GID=

# AdGuard Home admin login
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=
